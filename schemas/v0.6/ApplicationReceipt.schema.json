{
  "$defs": {
    "CostTrace": {
      "additionalProperties": false,
      "properties": {
        "embedding_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Embedding Tokens",
          "type": "integer"
        },
        "hardware_seconds": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Hardware Seconds",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Latency Ms",
          "type": "number"
        },
        "model_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "schema_version": {
          "default": "ell.v0.6",
          "pattern": "^ell\\.v0\\.6$",
          "title": "Schema Version",
          "type": "string"
        },
        "storage_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Storage Bytes",
          "type": "integer"
        }
      },
      "title": "CostTrace",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "ell.v0.6",
          "pattern": "^ell\\.v0\\.6$",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "span_id": {
          "minLength": 1,
          "title": "Span Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "span_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "$id": "https://ell.dev/schemas/v0.6/ApplicationReceipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "application_id": {
      "minLength": 1,
      "title": "Application Id",
      "type": "string"
    },
    "concept_versions": {
      "items": {
        "type": "string"
      },
      "title": "Concept Versions",
      "type": "array"
    },
    "cost": {
      "$ref": "#/$defs/CostTrace"
    },
    "decision": {
      "minLength": 1,
      "title": "Decision",
      "type": "string"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "observed_time": {
      "format": "date-time",
      "title": "Observed Time",
      "type": "string"
    },
    "policy_id": {
      "minLength": 1,
      "title": "Policy Id",
      "type": "string"
    },
    "restored_evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Restored Evidence",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "ell.v0.6",
      "pattern": "^ell\\.v0\\.6$",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_record_ids": {
      "items": {
        "type": "string"
      },
      "title": "Selected Record Ids",
      "type": "array"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "workspace_id": {
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "application_id",
    "run_id",
    "workspace_id",
    "task_id",
    "selected_record_ids",
    "concept_versions",
    "restored_evidence",
    "decision",
    "policy_id",
    "model_id",
    "cost",
    "observed_time"
  ],
  "title": "ApplicationReceipt",
  "type": "object"
}
