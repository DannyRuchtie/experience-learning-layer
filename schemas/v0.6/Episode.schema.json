{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "ell.v0.6",
          "pattern": "^ell\\.v0\\.6$",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "span_id": {
          "minLength": 1,
          "title": "Span Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "span_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "private",
        "restricted"
      ],
      "title": "Sensitivity",
      "type": "string"
    }
  },
  "$id": "https://ell.dev/schemas/v0.6/Episode.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action"
    },
    "context": {
      "minLength": 1,
      "title": "Context",
      "type": "string"
    },
    "episode_id": {
      "minLength": 1,
      "title": "Episode Id",
      "type": "string"
    },
    "event_time_end": {
      "format": "date-time",
      "title": "Event Time End",
      "type": "string"
    },
    "event_time_start": {
      "format": "date-time",
      "title": "Event Time Start",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "observation": {
      "minLength": 1,
      "title": "Observation",
      "type": "string"
    },
    "observed_time": {
      "format": "date-time",
      "title": "Observed Time",
      "type": "string"
    },
    "outcome": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome"
    },
    "schema_version": {
      "default": "ell.v0.6",
      "pattern": "^ell\\.v0\\.6$",
      "title": "Schema Version",
      "type": "string"
    },
    "sensitivity": {
      "$ref": "#/$defs/Sensitivity",
      "default": "private"
    },
    "tombstoned": {
      "default": false,
      "title": "Tombstoned",
      "type": "boolean"
    },
    "workspace_id": {
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "episode_id",
    "workspace_id",
    "context",
    "observation",
    "evidence",
    "event_time_start",
    "event_time_end",
    "observed_time"
  ],
  "title": "Episode",
  "type": "object"
}
