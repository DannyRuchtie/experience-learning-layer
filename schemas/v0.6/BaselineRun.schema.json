{
  "$defs": {
    "ApplicationReceipt": {
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "minLength": 1,
          "title": "Application Id",
          "type": "string"
        },
        "concept_versions": {
          "items": {
            "type": "string"
          },
          "title": "Concept Versions",
          "type": "array"
        },
        "cost": {
          "$ref": "#/$defs/CostTrace"
        },
        "decision": {
          "minLength": 1,
          "title": "Decision",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "observed_time": {
          "format": "date-time",
          "title": "Observed Time",
          "type": "string"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "restored_evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Restored Evidence",
          "type": "array"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "ell.v0.6",
          "pattern": "^ell\\.v0\\.6$",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_record_ids": {
          "items": {
            "type": "string"
          },
          "title": "Selected Record Ids",
          "type": "array"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "workspace_id": {
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "application_id",
        "run_id",
        "workspace_id",
        "task_id",
        "selected_record_ids",
        "concept_versions",
        "restored_evidence",
        "decision",
        "policy_id",
        "model_id",
        "cost",
        "observed_time"
      ],
      "title": "ApplicationReceipt",
      "type": "object"
    },
    "BaselineTaskResult": {
      "additionalProperties": false,
      "properties": {
        "correct": {
          "title": "Correct",
          "type": "boolean"
        },
        "cost": {
          "$ref": "#/$defs/CostTrace"
        },
        "prediction": {
          "title": "Prediction",
          "type": "string"
        },
        "scores": {
          "items": {
            "type": "number"
          },
          "title": "Scores",
          "type": "array"
        },
        "selected_record_ids": {
          "items": {
            "type": "string"
          },
          "title": "Selected Record Ids",
          "type": "array"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "prediction",
        "selected_record_ids",
        "scores",
        "correct",
        "cost"
      ],
      "title": "BaselineTaskResult",
      "type": "object"
    },
    "CostTrace": {
      "additionalProperties": false,
      "properties": {
        "embedding_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Embedding Tokens",
          "type": "integer"
        },
        "hardware_seconds": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Hardware Seconds",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Latency Ms",
          "type": "number"
        },
        "model_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "schema_version": {
          "default": "ell.v0.6",
          "pattern": "^ell\\.v0\\.6$",
          "title": "Schema Version",
          "type": "string"
        },
        "storage_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Storage Bytes",
          "type": "integer"
        }
      },
      "title": "CostTrace",
      "type": "object"
    },
    "EvaluatorJudgment": {
      "additionalProperties": false,
      "properties": {
        "cited_support_ids": {
          "items": {
            "type": "string"
          },
          "title": "Cited Support Ids",
          "type": "array"
        },
        "evaluator_id": {
          "minLength": 1,
          "title": "Evaluator Id",
          "type": "string"
        },
        "judgment_id": {
          "minLength": 1,
          "title": "Judgment Id",
          "type": "string"
        },
        "material_counterevidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Material Counterevidence Ids",
          "type": "array"
        },
        "missed_counterevidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Missed Counterevidence Ids",
          "type": "array"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "ell.v0.6",
          "pattern": "^ell\\.v0\\.6$",
          "title": "Schema Version",
          "type": "string"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        },
        "system_blinded": {
          "title": "System Blinded",
          "type": "boolean"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "unsupported_generalization": {
          "title": "Unsupported Generalization",
          "type": "boolean"
        }
      },
      "required": [
        "judgment_id",
        "run_id",
        "task_id",
        "evaluator_id",
        "system_blinded",
        "success",
        "unsupported_generalization",
        "cited_support_ids",
        "material_counterevidence_ids",
        "missed_counterevidence_ids"
      ],
      "title": "EvaluatorJudgment",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "ell.v0.6",
          "pattern": "^ell\\.v0\\.6$",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "span_id": {
          "minLength": 1,
          "title": "Span Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "span_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "RunManifest": {
      "additionalProperties": false,
      "properties": {
        "benchmark_version": {
          "minLength": 1,
          "title": "Benchmark Version",
          "type": "string"
        },
        "configuration_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Configuration Hash",
          "type": "string"
        },
        "cost": {
          "$ref": "#/$defs/CostTrace"
        },
        "dataset_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Dataset Hash",
          "type": "string"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "generator_id": {
          "minLength": 1,
          "title": "Generator Id",
          "type": "string"
        },
        "logical_started_at": {
          "format": "date-time",
          "title": "Logical Started At",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "partition": {
          "pattern": "^(train|development|sealed)$",
          "title": "Partition",
          "type": "string"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "ell.v0.6",
          "pattern": "^ell\\.v0\\.6$",
          "title": "Schema Version",
          "type": "string"
        },
        "seed_commitment": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Seed Commitment",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "benchmark_version",
        "partition",
        "dataset_hash",
        "configuration_hash",
        "generator_id",
        "seed_commitment",
        "policy_id",
        "model_id",
        "logical_started_at",
        "cost",
        "environment"
      ],
      "title": "RunManifest",
      "type": "object"
    }
  },
  "$id": "https://ell.dev/schemas/v0.6/BaselineRun.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accuracy": {
      "title": "Accuracy",
      "type": "number"
    },
    "baseline_id": {
      "title": "Baseline Id",
      "type": "string"
    },
    "dataset_hash": {
      "title": "Dataset Hash",
      "type": "string"
    },
    "evidence_precision": {
      "title": "Evidence Precision",
      "type": "number"
    },
    "judgments": {
      "items": {
        "$ref": "#/$defs/EvaluatorJudgment"
      },
      "title": "Judgments",
      "type": "array"
    },
    "manifest": {
      "$ref": "#/$defs/RunManifest"
    },
    "partition": {
      "title": "Partition",
      "type": "string"
    },
    "receipts": {
      "items": {
        "$ref": "#/$defs/ApplicationReceipt"
      },
      "title": "Receipts",
      "type": "array"
    },
    "task_results": {
      "items": {
        "$ref": "#/$defs/BaselineTaskResult"
      },
      "title": "Task Results",
      "type": "array"
    }
  },
  "required": [
    "baseline_id",
    "partition",
    "dataset_hash",
    "task_results",
    "accuracy",
    "evidence_precision",
    "receipts",
    "judgments",
    "manifest"
  ],
  "title": "BaselineRun",
  "type": "object"
}
