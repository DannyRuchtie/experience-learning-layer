{
  "$defs": {
    "PermissionGrant": {
      "additionalProperties": false,
      "properties": {
        "principal_id": {
          "minLength": 1,
          "title": "Principal Id",
          "type": "string"
        },
        "purposes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Purposes",
          "type": "array"
        },
        "schema_version": {
          "default": "ell.v0.6",
          "pattern": "^ell\\.v0\\.6$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "principal_id",
        "purposes"
      ],
      "title": "PermissionGrant",
      "type": "object"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "private",
        "restricted"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "schema_version": {
          "default": "ell.v0.6",
          "pattern": "^ell\\.v0\\.6$",
          "title": "Schema Version",
          "type": "string"
        },
        "span_id": {
          "minLength": 1,
          "title": "Span Id",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "span_id",
        "start",
        "end",
        "text"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "$id": "https://ell.dev/schemas/v0.6/SourceArtifact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "consent": {
      "default": true,
      "title": "Consent",
      "type": "boolean"
    },
    "content": {
      "title": "Content",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "event_time": {
      "format": "date-time",
      "title": "Event Time",
      "type": "string"
    },
    "grants": {
      "items": {
        "$ref": "#/$defs/PermissionGrant"
      },
      "minItems": 1,
      "title": "Grants",
      "type": "array"
    },
    "observed_time": {
      "format": "date-time",
      "title": "Observed Time",
      "type": "string"
    },
    "schema_version": {
      "default": "ell.v0.6",
      "pattern": "^ell\\.v0\\.6$",
      "title": "Schema Version",
      "type": "string"
    },
    "sensitivity": {
      "$ref": "#/$defs/Sensitivity",
      "default": "private"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_type": {
      "minLength": 1,
      "title": "Source Type",
      "type": "string"
    },
    "spans": {
      "items": {
        "$ref": "#/$defs/SourceSpan"
      },
      "title": "Spans",
      "type": "array"
    },
    "tombstoned": {
      "default": false,
      "title": "Tombstoned",
      "type": "boolean"
    },
    "workspace_id": {
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "workspace_id",
    "source_type",
    "content",
    "content_hash",
    "spans",
    "event_time",
    "observed_time",
    "grants"
  ],
  "title": "SourceArtifact",
  "type": "object"
}
