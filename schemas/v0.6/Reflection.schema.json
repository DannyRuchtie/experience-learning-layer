{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "ell.v0.6",
          "pattern": "^ell\\.v0\\.6$",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "span_id": {
          "minLength": 1,
          "title": "Span Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "span_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ReviewState": {
      "enum": [
        "quarantined",
        "validated",
        "rejected",
        "committed"
      ],
      "title": "ReviewState",
      "type": "string"
    }
  },
  "$id": "https://ell.dev/schemas/v0.6/Reflection.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "counterevidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Counterevidence",
      "type": "array"
    },
    "generated_by": {
      "minLength": 1,
      "title": "Generated By",
      "type": "string"
    },
    "observed_time": {
      "format": "date-time",
      "title": "Observed Time",
      "type": "string"
    },
    "reflection_id": {
      "minLength": 1,
      "title": "Reflection Id",
      "type": "string"
    },
    "reflection_type": {
      "minLength": 1,
      "title": "Reflection Type",
      "type": "string"
    },
    "review_state": {
      "$ref": "#/$defs/ReviewState",
      "default": "quarantined"
    },
    "schema_version": {
      "default": "ell.v0.6",
      "pattern": "^ell\\.v0\\.6$",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "items": {
        "type": "string"
      },
      "title": "Scope",
      "type": "array"
    },
    "statement": {
      "minLength": 1,
      "title": "Statement",
      "type": "string"
    },
    "support": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Support",
      "type": "array"
    },
    "uncertainty": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Uncertainty",
      "type": "number"
    },
    "workspace_id": {
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "reflection_id",
    "workspace_id",
    "statement",
    "reflection_type",
    "scope",
    "support",
    "counterevidence",
    "uncertainty",
    "generated_by",
    "observed_time"
  ],
  "title": "Reflection",
  "type": "object"
}
