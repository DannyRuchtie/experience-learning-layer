{
  "$defs": {
    "BenchmarkPartition": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^(train|development|sealed)$",
          "title": "Name",
          "type": "string"
        },
        "records": {
          "items": {
            "$ref": "#/$defs/ExperienceRecord"
          },
          "title": "Records",
          "type": "array"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskCase"
          },
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "name",
        "records",
        "tasks"
      ],
      "title": "BenchmarkPartition",
      "type": "object"
    },
    "ExperienceRecord": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "change_point": {
          "default": false,
          "title": "Change Point",
          "type": "boolean"
        },
        "correlation_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Group"
        },
        "deleted": {
          "default": false,
          "title": "Deleted",
          "type": "boolean"
        },
        "observed_time": {
          "format": "date-time",
          "title": "Observed Time",
          "type": "string"
        },
        "outcome": {
          "title": "Outcome",
          "type": "number"
        },
        "outcome_observed_time": {
          "format": "date-time",
          "title": "Outcome Observed Time",
          "type": "string"
        },
        "permission": {
          "default": "benchmark",
          "pattern": "^(benchmark|denied)$",
          "title": "Permission",
          "type": "string"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "regime": {
          "default": 0,
          "minimum": 0,
          "title": "Regime",
          "type": "integer"
        },
        "relation": {
          "pattern": "^(supports|contradicts|exception|distractor)$",
          "title": "Relation",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "workspace_id",
        "rule_id",
        "sequence",
        "observed_time",
        "text",
        "scope",
        "action",
        "outcome",
        "outcome_observed_time",
        "relation"
      ],
      "title": "ExperienceRecord",
      "type": "object"
    },
    "TaskCase": {
      "additionalProperties": false,
      "properties": {
        "allowed_actions": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Actions",
          "type": "array"
        },
        "episodes_since_change": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Episodes Since Change"
        },
        "gold_action": {
          "title": "Gold Action",
          "type": "string"
        },
        "gold_counterevidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Gold Counterevidence Ids",
          "type": "array"
        },
        "gold_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Gold Evidence Ids",
          "type": "array"
        },
        "observed_time": {
          "format": "date-time",
          "title": "Observed Time",
          "type": "string"
        },
        "query": {
          "title": "Query",
          "type": "string"
        },
        "regime": {
          "default": 0,
          "minimum": 0,
          "title": "Regime",
          "type": "integer"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "transfer": {
          "pattern": "^(near|intermediate|far)$",
          "title": "Transfer",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "workspace_id",
        "rule_id",
        "sequence",
        "observed_time",
        "query",
        "scope",
        "transfer",
        "allowed_actions",
        "gold_action",
        "gold_evidence_ids",
        "gold_counterevidence_ids"
      ],
      "title": "TaskCase",
      "type": "object"
    }
  },
  "$id": "https://ell.dev/schemas/v0.6/BenchmarkDataset.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "benchmark_version": {
      "default": "ell-benchmark.v0.1",
      "title": "Benchmark Version",
      "type": "string"
    },
    "generator_id": {
      "title": "Generator Id",
      "type": "string"
    },
    "partitions": {
      "items": {
        "$ref": "#/$defs/BenchmarkPartition"
      },
      "title": "Partitions",
      "type": "array"
    },
    "seed_commitment": {
      "title": "Seed Commitment",
      "type": "string"
    }
  },
  "required": [
    "generator_id",
    "seed_commitment",
    "partitions"
  ],
  "title": "BenchmarkDataset",
  "type": "object"
}
