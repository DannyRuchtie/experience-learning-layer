    "ell_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ell Run Id"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "title": "Gates",
      "type": "array"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    }
  },
  "required": [
    "verdict",
    "ell_run_id",
    "comparator_run_id",
    "gates",
