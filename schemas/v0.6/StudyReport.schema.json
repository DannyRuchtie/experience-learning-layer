      "title": "Verdict",
      "type": "string"
    }
  },
  "$id": "https://ell.dev/schemas/v0.6/StudyReport.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
