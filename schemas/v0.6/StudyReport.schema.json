{
  "$defs": {
    "GateResult": {
      "additionalProperties": false,
      "properties": {
        "gate": {
          "title": "Gate",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/GateState"
        },
        "threshold": {
          "title": "Threshold",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
